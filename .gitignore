# ==============================================================================
# 1. Môi trường Python & Caching (Python & Virtual Environments)
# ==============================================================================
# Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Môi trường ảo (Virtual Environments)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Phân phối / Đóng gói (Distribution / Packaging)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Thư viện kiểm thử & Coverage (Testing & QA)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml
*.cover

# ==============================================================================
# 2. Jupyter Notebooks
# ==============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.run.xml

# ==============================================================================
# 3. Big Data Data Lake & File Dữ Liệu (Data Files)
# ==============================================================================
# Thư mục dữ liệu cục bộ (Bronze, Silver, Gold, Raw, Processed, Staging)
data/producer/
raw_data/
processed_data/
storage/

# Thư mục dữ liệu phát sinh theo quy trình
dataset/raw/
dataset/state/
dataset/sample/
dataset/*.xlsx

# Định dạng dữ liệu nhị phân & file nén lớn
*.parquet
*.orc
*.avro
*.feather
*.h5
*.gz
*.tar.gz
*.zip
*.lz4
*.snappy

# Giữ lại cấu trúc thư mục nếu có file .gitkeep
!**/data/**/.gitkeep
!**/dataset/**/.gitkeep

# Không bỏ qua các file tài liệu hoặc cấu hình dạng CSV/JSON trong docs/
!docs/**/*.csv
!docs/*.csv

# ==============================================================================
# 4. Apache Spark & Hadoop
# ==============================================================================
# Metastore và Warehouse của Spark/Hive
spark-warehouse/
metastore_db/
derby.log
derby-*.log
*.spark-deps

# Spark Checkpoints & Event logs
checkpoint/
checkpoints/
*_checkpoint/
spark-events/
event-logs/

# Hadoop & HDFS checksums, temporary files
*.crc
*.tmp
_temporary/
_SUCCESS

# ==============================================================================
# 5. Apache Kafka, Streaming & Broker Logs
# ==============================================================================
kafka_data/
zookeeper-data/
*.kafka
kafka-logs/
zookeeper.out

# ==============================================================================
# 6. MinIO & Object Storage cục bộ
# ==============================================================================
minio_data/
.minio.sys/

# ==============================================================================
# 7. Redis & Celery (Databases, Caches & Schedules)
# ==============================================================================
dump.rdb
appendonly.aof
*.rdb
redis_data/
redis/redis.conf
!redis/redis.conf.example

# Celery Beat schedules
celerybeat-schedule*
*.sched

# ==============================================================================
# 8. Apache Airflow / Orchestration (nếu dùng)
# ==============================================================================
airflow/
airflow.db
airflow.cfg
airflow.pod
standalone_admin_password.txt

# ==============================================================================
# 9. Biến môi trường & Bảo mật (Secrets & Credentials)
# ==============================================================================
.env
.env.*
*.env
docker/.env
batch/.env
!*.env.example
!**/*.env.example

# Khóa bí mật & Chứng chỉ số
*.pem
*.key
*.crt
*.pfx
*.keystore
*secret*.json
credentials.json
service-account*.json

# ==============================================================================
# 10. Logs & Tệp tạm (Logs & Temp Files)
# ==============================================================================
logs/
*.log
*.pid
*.seed
*.pid.lock
tmp/
temp/

# ==============================================================================
# 11. IDE & Trình soạn thảo mã nguồn (Editors & IDEs)
# ==============================================================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, IntelliJ, ...)
.idea/
*.iml
*.iws

# Khác
*.sublime-project
*.sublime-workspace
.project
.pydevproject

# ==============================================================================
# 12. Hệ điều hành (OS Generated Files)
# ==============================================================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
