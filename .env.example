# ==============================================================================
# Last.fm API Configuration
# ==============================================================================
# Lấy API key tại: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
# Danh sách username Last.fm cần crawl, phân tách bằng dấu phẩy
LASTFM_USERS=username1,username2
LASTFM_MAX_RPS=1.0
LASTFM_MIN_INTERVAL=0.4

# ==============================================================================
# Storage / MinIO Configuration
# ==============================================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=bronze
MINIO_DEFAULT_BUCKET=bronze
MINIO_SECURE=false
MINIO_PREFIX=events

# ==============================================================================
# Kafka Broker & Topics Configuration
# ==============================================================================
# Khi chạy trên máy host: localhost:9092. Khi chạy trong Docker Compose: kafka:9094 (hoặc kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=events.bronze.lastfm
DLQ_TOPIC=events.bronze.dead-letter
KAFKA_DLQ_TOPIC=events.bronze.dead-letter
KAFKA_DEMO_TOPIC=events.demo.lastfm
KAFKA_GROUP_ID=batch-bronze-consumer

# ==============================================================================
# Redis & Celery Configuration (Có mật khẩu xác thực)
# ==============================================================================
REDIS_PASSWORD=change-me-long-random
CELERY_BROKER_URL=redis://:change-me-long-random@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-long-random@localhost:6379/1

# ==============================================================================
# Batch Consumer & Micro-Batching Tuning
# ==============================================================================
BATCH_BUFFER_SIZE_BYTES=134217728
BATCH_FLUSH_INTERVAL_SECONDS=1800
GC_MAX_AGE_SECONDS=86400
