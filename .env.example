# ==============================================================================
# Last.fm API Configuration
# ==============================================================================
# Lấy API key tại: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
# File danh sách user Last.fm dùng cho lập lịch hàng giờ và bulk (mặc định: toàn bộ 500 user trong file)
LASTFM_USERS_FILE=dataset/users/showoffs_all_users.json
# Lọc theo trạng thái user trong file ('all' = lấy toàn bộ, hoặc 'A', 'A,?' ...)
LASTFM_USER_STATUSES=all
# Danh sách username dự phòng (fallback) nếu không dùng LASTFM_USERS_FILE hoặc đặt LASTFM_USERS_FILE=""
LASTFM_USERS=username1,username2
LASTFM_MAX_RPS=1.0
LASTFM_MIN_INTERVAL=0.4
PRODUCER_OUTPUT_DIR=data/producer

# ==============================================================================
# Storage / MinIO Configuration
# ==============================================================================
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=bronze
MINIO_SECURE=false
MINIO_PREFIX=events

# ==============================================================================
# Kafka Broker & Topics Configuration
# ==============================================================================
# Khi chạy trên máy host: localhost:9092. Khi chạy trong Docker Compose: kafka:9094 (hoặc kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=events.bronze.lastfm
KAFKA_DLQ_TOPIC=events.bronze.dead-letter
KAFKA_DEMO_TOPIC=events.demo.lastfm
KAFKA_GROUP_ID=batch-bronze-consumer

# ==============================================================================
# Redis & Celery Configuration (Có mật khẩu xác thực)
# ==============================================================================
REDIS_PASSWORD=change-me-long-random
CELERY_BROKER_URL=redis://:change-me-long-random@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-long-random@localhost:6379/1
CELERY_WORKER_CONCURRENCY=4
CELERY_SILVER_CONCURRENCY=1
BATCH_PRODUCER_WORKERS=4

# ==============================================================================
# Batch Consumer & Micro-Batching Tuning
# ==============================================================================
BATCH_BUFFER_SIZE_BYTES=134217728
BATCH_FLUSH_INTERVAL_SECONDS=3600
GC_MAX_AGE_SECONDS=86400

# ==============================================================================
# Batch Silver & Quality Delta Lake Configuration
# ==============================================================================
SILVER_PIPELINE_VERSION=1.0.0
SILVER_BASE_PATH=data/delta/silver
QUALITY_BASE_PATH=data/delta/quality
DEMO_SILVER_BASE_PATH=data/delta/silver_demo
SILVER_FUTURE_THRESHOLD_SECONDS=300
SILVER_PARTITION_BY_DATE=false
SILVER_LOCK_FILE=data/delta/.silver_job.lock
SILVER_PUSH_MINIO=false
MINIO_SILVER_BUCKET=silver
MINIO_QUALITY_BUCKET=quality
MINIO_DEMO_SILVER_BUCKET=silver-demo
MINIO_SILVER_PREFIX=
SILVER_PUSH_INCLUDE_QUALITY=true
SILVER_PUSH_FORCE=false
