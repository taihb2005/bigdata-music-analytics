# Copy thành .env (file này KHÔNG được commit). Docker Compose cũng đọc .env để thay biến.
LASTFM_API_KEY=your_lastfm_api_key
# Mật khẩu Redis: bắt buộc, dùng chuỗi dài ngẫu nhiên
REDIS_PASSWORD=change-me-long-random
# Tổng request/giây tới Last.fm (producer + metadata worker). Khuyến cáo <= 1
LASTFM_MAX_RPS=1.0
# Chỉ cần khi chạy profile batch (MinIO)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-min-8-chars
