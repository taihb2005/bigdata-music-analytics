*.py[cod]
*$py.class
*.so
.Python

# Môi trường ảo (Virtual Environments)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Phân phối / Đóng gói (Distribution / Packaging)
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
