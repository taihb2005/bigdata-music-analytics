# Keep the API key on your machine. Do not commit .env.
LASTFM_API_KEY=dien_api_key_cua_ban_vao_day
# Comma-separated Last.fm usernames. Start with one user.
LASTFM_USERS=dien_username_cua_ban_vao_day
# Internal Docker address. Host applications use localhost:19092.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=events.bronze.lastfm
KAFKA_DLQ_TOPIC=events.bronze.lastfm.dlq
KAFKA_DEMO_TOPIC=events.demo.lastfm
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
LASTFM_MIN_INTERVAL=0.4
